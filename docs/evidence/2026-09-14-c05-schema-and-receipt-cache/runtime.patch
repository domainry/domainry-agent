+	records := &runtimeAssembly{
+		schema:          map[string]definitionmodel.ObjectSchema{"customer": {Key: "customer", Fields: []definitionmodel.FieldSchema{{Key: "name", Type: "text"}}}},
+		actions:         map[string]definitionmodel.ActionSchema{},
